# ==============================================================================
# PulsePredict AI - Enterprise Health Risk Assessment Platform
# System Environment Configuration
# ==============================================================================

# Application Metadata
PROJECT_NAME=PulsePredict AI
ENVIRONMENT=development
DEBUG=True
API_V1_STR=/api/v1
SECRET_KEY=change_this_to_a_cryptographically_secure_random_key_in_production_min32chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS & Host Origins
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# PostgreSQL Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=pulseadmin
POSTGRES_PASSWORD=pulseadmin_secure_pw_2026
POSTGRES_DB=pulsepredict_db
DATABASE_URL=postgresql+asyncpg://pulseadmin:pulseadmin_secure_pw_2026@localhost:5432/pulsepredict_db
SYNC_DATABASE_URL=postgresql+psycopg2://pulseadmin:pulseadmin_secure_pw_2026@localhost:5432/pulsepredict_db

# Redis & Celery Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ML Engine & Artifact Paths
MODEL_REGISTRY_PATH=./ml_engine/saved_models
DEFAULT_MODEL_VERSION=v1.0.0
ML_INFERENCE_TIMEOUT_SECONDS=5.0
ENABLE_SHAP_EXPLAINABILITY=True

# Storage & PDF Configuration
STORAGE_ROOT=./storage
PDF_REPORTS_DIR=./storage/reports
MAX_UPLOAD_SIZE_MB=10

# Security & Rate Limiting
RATE_LIMIT_PER_MINUTE=120
AUTH_RATE_LIMIT_PER_MINUTE=10
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=15
